# Local-only credentials. Keep URL passwords synchronized with Compose variables.
DATABASE_URL=postgresql://stockflow:local_only_change_me@localhost:5432/stockflow
TEST_DATABASE_URL=postgresql://stockflow:local_test_only@localhost:5433/stockflow_test
POSTGRES_USER=stockflow
POSTGRES_PASSWORD=local_only_change_me
POSTGRES_DB=stockflow
TEST_POSTGRES_PASSWORD=local_test_only
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
BETTER_AUTH_URL=http://localhost:3000
TAX_RATE_BPS=1100
# Next overrides this for build/start; harness children receive their own environment.
NODE_ENV=development
